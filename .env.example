STORYMOTION_DATA_DIR=./data
# Local automatic Spanish narration (included in Docker):
# STORYMOTION_VOICE_PYTHON=/absolute/path/to/voice-env/bin/python
# STORYMOTION_VOICE_MODEL=/absolute/path/to/voices/es_MX-ald-medium.onnx
# Hosted single-owner access: browser username is storymotion.
# STORYMOTION_ACCESS_PASSWORD=
# STORYMOTION_RENDER_CONCURRENCY=1
# Optional: system Chromium. Without it Remotion uses its installed headless shell.
# CHROME_EXECUTABLE=/usr/bin/chromium
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
# Optional image provider configuration, server-side only:
# IMAGE_PROVIDER_URL=https://your-provider.example/generate
# IMAGE_PROVIDER_KEY=
# Optional semantic story analyzer endpoint, JSON request/response (see README):
# STORY_ANALYZER_URL=https://your-provider.example/analyze
# STORY_ANALYZER_KEY=

# ActionMotion Director: local, persistent, reviewed production by default.
ACTIONMOTION_AGENT_ENABLED=true
ACTIONMOTION_AGENT_MODE=SEMI_AUTO
ACTIONMOTION_REQUIRE_APPROVAL=true
ACTIONMOTION_EXTERNAL_PAID_CALLS=false
# Optional Ollama local structured analysis (model must already be installed):
# ACTIONMOTION_OLLAMA_URL=http://127.0.0.1:11434
# ACTIONMOTION_OLLAMA_MODEL=qwen2.5:7b
