{
  "name": "storymotion",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:web": "next dev --hostname 0.0.0.0",
    "build": "next build --webpack",
    "start": "tsx scripts/start.ts",
    "worker": "tsx scripts/worker.ts",
    "demo": "tsx scripts/demo.ts",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "verify": "tsx scripts/verify.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write src scripts tests e2e *.ts *.mjs *.json README.md docs/*.md"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.533",
    "@remotion/player": "4.0.533",
    "@remotion/renderer": "4.0.533",
    "dotenv": "^18.0.6",
    "lucide-react": "^0.577.0",
    "next": "16.4.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "remotion": "4.0.533",
    "sharp": "^0.34.5",
    "tsx": "^4.23.15",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@tailwindcss/postcss": "^4.2.0",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.2.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24"
  }
}
